    "固有天賦": [
        {
            "名前": "最後の詩詠者",
            "説明": "元素スキル<span style=\"color:#FFD780FF\">流れる朝のレチタティーヴォ</span>発動時、フィールド上の星の嵐を「流星の嵐」へ変化させる。また、付近にいるチーム内キャラクターが<span style=\"color:#FFD780FF\">悠久の歌</span>効果の継続期間中に星拡散反応を起こすと、星の嵐の代わりに流星の嵐を生成する。<br>流星の嵐を生成または起爆させた時、付近の敵の<span style=\"color:#80FFD7FF\">風元素耐性</span>-35%、継続時間6秒。<br>さらに、<span style=\"color:#FFD780FF\">悠久の歌</span>の継続期間中、付近にいるチーム内キャラクターが<span style=\"color:#FFD780FF\">輝映·星拡散</span>状態に入った時、<span style=\"color:#FFD780FF\">輝映·星拡散</span>の継続時間が4秒延長される。",
            "icon_url": "images/characters/hydro_5_catalyst_Vodyanitsa/talent_4.png",
            "詳細": []
        },
        {
            "名前": "十二弦の涙唄",
            "説明": "元素スキル<span style=\"color:#FFD780FF\">流れる朝のレチタティーヴォ</span>発動時、ヴォジャニーツァは25層の<span style=\"color:#FFD780FF\">「メロディ」</span>と10層の<span style=\"color:#FFD780FF\">「コーラス」</span>を獲得する。<br>上記の2種類の効果はそれぞれ継続時間30秒、元素スキル発動時に層数が更新される。",
            "icon_url": "images/characters/hydro_5_catalyst_Vodyanitsa/talent_5.png",
            "詳細": []
        },
        {
            "名前": "氷湖を巡る余韻",
            "説明": "非戦闘状態の時、元素スキルを長押しすると、ヴォジャニーツァは水の精としての本来の姿を現し、スタミナを消費する代わりに、最大10秒間の遊泳を行う。水の精であるため、水面の移動も可能。再び元素スキルを発動する、継続時間が終了する、あるいはスタミナが尽きた時、ヴォジャニーツァは水の精の姿を解除する。<br>また、ヴォジャニーツァの泳ぐ速度がアップし、スタミナの消費量も増える。",
            "icon_url": "images/characters/hydro_5_catalyst_Vodyanitsa/talent_6.png",
            "詳細": []
        },
        {
            "名前": "無弦の誘い歌",
            "説明": "ヴォジャニーツァはコロレフスキー劇団のプリマドンナとして、楽器を演奏する代わりに、自らの歌声を披露する。",
            "icon_url": "images/characters/hydro_5_catalyst_Vodyanitsa/talent_7.png",
