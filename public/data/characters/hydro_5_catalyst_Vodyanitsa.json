    "固有天賦": [
        {
            "名前": "最後の詩詠者",
            "説明": "元素スキル<span style=\"color:#FFD780FF\">流れる朝のレチタティーヴォ</span>発動時、フィールド上の星の嵐を「流星の嵐」へ変化させる。また、付近にいるチーム内キャラクターが<span style=\"color:#FFD780FF\">悠久の歌</span>効果の継続期間中に星拡散反応を起こすと、星の嵐の代わりに流星の嵐を生成する。<br>流星の嵐を生成または起爆させた時、付近の敵の<span style=\"color:#80FFD7FF\">風元素耐性</span>-35%、継続時間6秒。<br>さらに、<span style=\"color:#FFD780FF\">悠久の歌</span>の継続期間中、付近にいるチーム内キャラクターが<span style=\"color:#FFD780FF\">輝映·星拡散</span>状態に入った時、<span style=\"color:#FFD780FF\">輝映·星拡散</span>の継続時間が4秒延長される。",
            "icon_url": "images/characters/hydro_5_catalyst_Vodyanitsa/talent_4.png",
            "詳細": [
                {
                    "条件": "流星の嵐",
                    "種類": "敵風元素耐性",
                    "数値": -35.0
                }
            ]
        },
        {
            "名前": "十二弦の涙唄",
            "説明": "元素スキル<span style=\"color:#FFD780FF\">流れる朝のレチタティーヴォ</span>発動時、ヴォジャニーツァは25層の<span style=\"color:#FFD780FF\">「メロディ」</span>と10層の<span style=\"color:#FFD780FF\">「コーラス」</span>を獲得する。<br>上記の2種類の効果はそれぞれ継続時間30秒、元素スキル発動時に層数が更新される。<br><br><span style=\"color:#FFD780FF\">メロディ</span><br>チーム内の自身のフィールド上キャラクターの通常攻撃・重撃・落下攻撃・元素スキルまたは元素爆発が水元素ダメージまたは氷元素ダメージを与える時、「メロディ」を1層消費し、与えるダメージをアップさせる。フィールド上に流星の嵐が存在している、または流星の嵐の起爆後5秒以内である場合、キャラクターが星拡散反応ダメージを与える時のみ上記の効果が発動する。<br>ヴォジャニーツァのHP上限が40000を超えている時、その上限が1000超えるごとに上記の効果における星拡散反応ダメージ+260、水元素ダメージと氷元素ダメージ+140。この方法でアップできる星拡散反応ダメージは最大6500まで、水元素ダメージと氷元素ダメージは最大3500まで。<br><br><span style=\"color:#FFD780FF\">コーラス</span><br>チーム内の待機キャラクター、または付近にいるチーム内の他のキャラクター（チーム内の現在フィールド上のキャラクターを除く）によって発動される。効果は「メロディ」と同じ。",
            "icon_url": "images/characters/hydro_5_catalyst_Vodyanitsa/talent_5.png",
            "詳細": [
                {
                    "条件": "メロディ^コーラス",
